<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct-share targets (Sharing Shortcuts, API 29+): pinned peers surface
  inside the system share sheet as "Flit · peer". Categories must match
  FlitShortcuts.SHARE_CATEGORY; the class must match the share activity.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="app.flit.share.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="app.flit.share.category" />
    </share-target>
</shortcuts>
